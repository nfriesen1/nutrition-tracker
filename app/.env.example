# Expo app environment — copy to .env.local and fill in from the Supabase dashboard.
#
#   cp app/.env.example app/.env.local
#
# .env.local is gitignored. This template is not, and must never contain real values.
#
# !! EVERY EXPO_PUBLIC_* VALUE IS COMPILED INTO THE CLIENT BUNDLE AND IS PUBLIC. !!
# Anyone can read these out of the shipped JavaScript. That is fine for the anon key,
# which is designed for it. The Supabase SERVICE ROLE key must never appear here, or
# anywhere under app/ — it bypasses every authorization rule in docs/04-auth.md.
#
# Full reference: docs/06-deployment.md

# Supabase project URL — https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key. Public by design. NOT the service role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the Go API, used on native only.
#
# Web ignores this and calls same-origin /api, which Netlify proxies to Fly.
#
# Local development:
#   - simulator / emulator ....... http://localhost:8080
#   - physical device on the LAN .. http://<your-machine-lan-ip>:8080
#     (localhost on a phone means the phone; the Go service must also bind 0.0.0.0)
# Production native builds ....... https://<fly-app>.fly.dev
EXPO_PUBLIC_API_URL=http://localhost:8080
